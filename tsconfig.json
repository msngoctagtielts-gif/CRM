{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Node chạy kiểm thử bằng --experimental-strip-types nên import trong file
    // .test.ts phải ghi rõ đuôi .ts. Chỉ ảnh hưởng lúc kiểm kiểu (noEmit).
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // portal/ va web/ la hai ung dung Next.js RIENG, moi ben co tsconfig rieng.
  // Khong kiem kieu tu day, neu khong trinh bien dich se doi giai duong dan
  // @/* cua ben kia theo bang duong dan cua ben nay.
  "exclude": ["node_modules", "portal", "web"]
}
