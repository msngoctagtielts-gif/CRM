# ---------------------------------------------------------------
# MNEE Management System - environment variables
# Copy to .env.local and fill in. NEVER commit .env.local
# ---------------------------------------------------------------

# Public (safe for browser) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://zyzxqthlgrunkxohvhku.supabase.co
# Lấy ở Supabase Studio → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
NEXT_PUBLIC_APP_NAME=MNEE Management System
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_TIMEZONE=Asia/Ho_Chi_Minh
# Địa chỉ thật của hệ thống. Đường dẫn mời giáo viên trỏ về đây — đặt sai thì
# giáo viên bấm vào link sẽ rơi về localhost và không đặt được mật khẩu.
NEXT_PUBLIC_SITE_URL=https://<tên-miền-của-hệ-thống>

# Server only (NEVER expose to the browser) ---------------------
# Used only inside server actions / route handlers / cron jobs.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Shared secret required by /api/cron/* routes (n8n, Vercel Cron)
CRON_SECRET=<random-long-string>

# Supabase CLI
SUPABASE_PROJECT_ID=zyzxqthlgrunkxohvhku

# AI viết nháp nhận xét (D6) — TUỲ CHỌN, không đặt thì tính năng tự tắt.
# Lấy khoá MIỄN PHÍ ở https://aistudio.google.com/apikey (không cần thẻ).
# Xem docs/AI_SETUP.md. KHÔNG đặt tiền tố NEXT_PUBLIC_ — sẽ lộ khoá ra trình duyệt.
GOOGLE_AI_API_KEY=<google-ai-studio-key>
GOOGLE_AI_MODEL=gemini-3.6-flash
