# ---------------------------------------------------------------
# Website công khai - Ms.Ngọc Elite English
# Sao chép thành .env.local rồi điền. KHÔNG commit .env.local
#
# Website này CHỈ cần hai biến bắt buộc. Nó không có và không bao giờ
# được có SUPABASE_SERVICE_ROLE_KEY — không có biến nào để đặt nó.
# ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://zyzxqthlgrunkxohvhku.supabase.co
# Khoá anon, lấy ở Supabase Studio → Project Settings → API Keys.
# Khoá này công khai theo thiết kế: vai `anon` không đọc được bảng nào,
# nó chỉ gọi được đúng một hàm `dang_ky_tu_van`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Muối để băm địa chỉ IP khi đếm số lượt gửi biểu mẫu.
#
# KHÔNG ĐẶT thì tính năng chặn spam theo IP TỰ TẮT — website vẫn chạy bình
# thường, chỉ là một máy tự động có thể gửi liên tục. Thà vậy còn hơn lưu
# một bản băm không muối: không gian IPv4 đủ nhỏ để dò ngược ra trong vài
# phút, tức là vẫn đang lưu địa chỉ IP thật của người vào web.
#
# Sinh một chuỗi ngẫu nhiên dài:  openssl rand -hex 32
DANG_KY_SALT=<chuoi-ngau-nhien-dai>

# ---------------------------------------------------------------
# Chạy thử bản Cloudflare tại máy (npm run preview)
#
# `wrangler dev` KHÔNG đọc .env.local — nó đọc `.dev.vars`. Tạo một file
# `.dev.vars` cùng thư mục, nội dung là đúng hai biến NEXT_PUBLIC_ ở trên.
# File đó đã nằm trong .gitignore.
#
# Khi deploy thật thì đặt biến trong Cloudflare dashboard:
#   Workers & Pages → mnee-web → Settings → Variables and Secrets
#   - hai biến NEXT_PUBLIC_ đặt kiểu Text (chúng vốn công khai)
#   - DANG_KY_SALT đặt kiểu Secret
# ---------------------------------------------------------------
